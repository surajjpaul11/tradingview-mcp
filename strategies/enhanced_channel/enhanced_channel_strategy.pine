//@version=6
strategy("Enhanced Channel Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=1)

// ==============================================================================
// INPUTS
// ==============================================================================
grp_ch = "Channel Parameters"
tactical_len     = input.int(50, "Tactical Lookback (50-Bar)", minval=10, group=grp_ch, tooltip="Lookback period in bars for tactical swings (~50 daily bars)")
intermediate_len = input.int(200, "Intermediate Lookback (200-Bar)", minval=30, group=grp_ch, tooltip="Lookback period in bars for cyclical trend (~200 daily bars)")
macro_len        = input.int(1000, "Macro Lookback (1000-Bar)", minval=60, group=grp_ch, tooltip="Lookback period in bars for secular regime (~1000 daily bars)")
channel_mult     = input.float(1.7, "Channel Width Multiplier (StdErr)", minval=0.5, step=0.1, group=grp_ch)
leeway_pct       = input.float(5.0, "Boundary Leeway (%)", minval=1.0, maxval=20.0, step=0.5, group=grp_ch, tooltip="Percentage of channel height defining the edge bounce zone")
stopgap_pct      = input.float(5.0, "Stopgap Margin (%)", minval=1.0, maxval=20.0, step=0.5, group=grp_ch, tooltip="Margin below lower channel line before emergency stop loss triggers")

grp_filt = "Regime & Filters"
use_htf_filter     = input.bool(true, "Enable 1-Year HTF Filter", group=grp_filt, tooltip="Prevents 3M long entries when 1Y trend is declining sharply near the top of the 1Y range")
use_confluence     = input.bool(true, "Highlight Confluence Grade A Entries", group=grp_filt, tooltip="Highlights setups where 3M bottom bounce coincides with 1Y lower zone")
use_lower_reclaim  = input.bool(true, "Enable Lower Channel Reclaim", group=grp_filt, tooltip="Allows entries when price breaches lower channel and reclaims back above it")
use_channel_curl   = input.bool(true, "Enable Channel Curl Buy", group=grp_filt, tooltip="Allows entries when declining channel flattens and curls upwards")
use_midline_cross  = input.bool(false, "Enable Midline Cross (Buy Up / Sell Down)", group=grp_filt, tooltip="Triggers buy when price crosses above midline, and triggers sell when price crosses below midline")
confirm_bars       = input.int(2, "Bounce Confirmation Bars", minval=1, maxval=2, group=grp_ch, tooltip="1 = single green bounce bar, 2 = 2 consecutive higher closes (recommended)")
stopgap_mode     = input.string("close", "Stopgap Trigger Mode", options=["close", "low"], group=grp_ch, tooltip="close = candle close below stopgap, low = intraday touch")
dynamic_size     = input.bool(true, "Enable Confluence Position Sizing", group=grp_filt, tooltip="100% on Confluence Grade A, 50% on Tactical-only")

grp_vis = "Visual Overlays"
show_tactical    = input.bool(true, "Show Tactical Channel (3M)", group=grp_vis)
show_intermediate = input.bool(true, "Show Intermediate Midline (1Y)", group=grp_vis)
show_macro       = input.bool(false, "Show Macro Midline (5Y)", group=grp_vis)


// ==============================================================================
// CHANNEL CALCULATION HELPER (LINEAR REGRESSION CHANNEL)
// ==============================================================================
f_linreg_channel(src, len, mult) =>
    mid = ta.linreg(src, len, 0)
    // Calculate regression slope to deduce intercept
    slope = (ta.linreg(src, len, 0) - ta.linreg(src, len, 1))
    // Standard error calculation over lookback window
    float sum_sq_err = 0.0
    for i = 0 to len - 1
        expected = mid - slope * i
        err = src[i] - expected
        sum_sq_err += err * err
    std_err = math.sqrt(sum_sq_err / math.max(1, len - 2))
    width = mult * std_err
    upper = mid + width
    lower = mid - width
    [mid, upper, lower, slope]

// Compute 3-Month Tactical Channel
[mid_3m, up_3m, low_3m, slope_3m] = f_linreg_channel(close, tactical_len, channel_mult)

// Compute 1-Year Intermediate Channel
[mid_1y, up_1y, low_1y, slope_1y] = f_linreg_channel(close, intermediate_len, channel_mult)

// Compute 5-Year Macro Channel
[mid_5y, up_5y, low_5y, slope_5y] = f_linreg_channel(close, macro_len, channel_mult)


// ==============================================================================
// LEEWAY & STOPGAP ZONES
// ==============================================================================
ch_height_3m   = up_3m - low_3m
leeway_margin  = ch_height_3m * (leeway_pct / 100.0)
stopgap_margin = ch_height_3m * (stopgap_pct / 100.0)

bottom_leeway_ceiling = low_3m + leeway_margin
stopgap_floor         = low_3m - stopgap_margin
top_leeway_floor      = up_3m - leeway_margin

// 1-Year Range Position Percentile
pos_1y_pct = (up_1y > low_1y) ? (close - low_1y) / (up_1y - low_1y) : 0.5


// ==============================================================================
// STRATEGY STATE & LOGIC
// ==============================================================================
var float active_stop_level = na
var bool  target_reached    = false

// 1. Entry Logic:
// Touch or breach into/below bottom leeway zone within last 3 bars
recent_touch_bottom = use_lower_reclaim ? (ta.lowest(low, 3) <= bottom_leeway_ceiling or ta.lowest(close, 3) <= low_3m) : (ta.lowest(low, 3) <= bottom_leeway_ceiling and ta.lowest(low, 3) >= stopgap_floor)

// Confirmed bounce (2-bar continuation OR Bullish Engulfing reclaim expansion)
bounce_1b = (close > open) and (close > close[1]) and (close > low_3m)
bounce_2b = bounce_1b and (close[1] > open[1]) and (close[1] > close[2])
bullish_engulfing = bounce_1b and (close > high[1]) and (math.max(close - open, close - close[1]) >= 0.015 * close[1])
bounce_confirmed = (confirm_bars == 2) ? (bounce_2b or bullish_engulfing) : bounce_1b

// Lower Channel Reclaim: Price moved from below/at lower band to above it on a confirmed bullish day
was_below_channel = (close[1] <= low_3m[1]) or (open <= low_3m) or (low <= low_3m)
reclaimed_channel = use_lower_reclaim and was_below_channel and (close > low_3m) and (close > open) and (close > close[1])

// Channel Inflection / Valley Curl: Midline was declining, flattens, and curls strictly upward
was_declining_mid = (mid_3m[2] < mid_3m[4]) or (mid_3m[1] < mid_3m[3])
ch_height = up_3m - low_3m
is_turning_up_mid = (mid_3m > mid_3m[1]) and ((mid_3m - mid_3m[1]) >= 0.003 * ch_height)
price_above_mid = (close >= mid_3m) and (close > open) and (close > close[1])
channel_curl_entry = use_channel_curl and was_declining_mid and is_turning_up_mid and price_above_mid

// Midline Cross Up Entry
mid_cross_up = use_midline_cross and ta.crossover(close, mid_3m) and (close > open) and (close > close[1])

// HTF Filter
htf_allowed = true
if use_htf_filter
    htf_ceiling = (reclaimed_channel or mid_cross_up) ? 0.75 : 0.60
    if slope_1y < -0.05 and pos_1y_pct > htf_ceiling
        htf_allowed := false

is_confluence = (pos_1y_pct <= 0.30)
should_enter_bottom = (recent_touch_bottom and bounce_confirmed) or (reclaimed_channel and bounce_confirmed) or channel_curl_entry or mid_cross_up
long_entry_condition = should_enter_bottom and htf_allowed and (strategy.position_size == 0)

var bool reached_mid = false

// 2. Position Management & Exit Logic
if strategy.position_size > 0
    // Ratchet stopgap upward as channel advances (never decrease stop loss)
    if na(active_stop_level) or stopgap_floor > active_stop_level
        active_stop_level := stopgap_floor

    // Track if price reached above the tactical midline
    if high >= mid_3m or close >= mid_3m
        reached_mid := true

    // Track if upper zone was reached
    if high >= top_leeway_floor or close >= top_leeway_floor
        target_reached := true

    // Midline Cross Exit: Price crosses below midline
    if use_midline_cross and ta.crossunder(close, mid_3m)
        strategy.close("Long", comment="Mid Cross Exit")
        active_stop_level := na
        target_reached    := false
        reached_mid       := false

    // Midline Stop Loss: Price reached above mid and now crosses below going down (e.g. 3 June 2026)
    if not use_midline_cross and reached_mid and close < mid_3m and close < open and close < close[1] and close[1] >= mid_3m[1]
        strategy.close("Long", comment="Mid Stop SL")
        active_stop_level := na
        target_reached    := false
        reached_mid       := false

    // Stopgap Exit: Price breaks below stopgap line
    is_stop_hit = (stopgap_mode == "close") ? (close < active_stop_level) : (close < active_stop_level or low < active_stop_level)
    if is_stop_hit
        strategy.close("Long", comment="Stopgap SL")
        active_stop_level := na
        target_reached    := false
        reached_mid       := false

    // Channel Top Rejection Exit: Touched top zone and turned downward
    downward_rejection = (close < open) and (close < close[1])
    if target_reached and downward_rejection
        strategy.close("Long", comment="Channel Top TP")
        active_stop_level := na
        target_reached    := false
        reached_mid       := false

// Execute Entry with Confluence Sizing
if long_entry_condition
    string comment_text = is_confluence and use_confluence ? "Confluence Buy (100%)" : "Tactical Buy (50%)"
    strategy.entry("Long", strategy.long, comment=comment_text)
    active_stop_level := stopgap_floor
    target_reached    := false
    reached_mid       := false


// ==============================================================================
// VISUALIZATIONS & PLOTS
// ==============================================================================
// Tactical 3M Channel
p_up   = plot(show_tactical ? up_3m : na, "3M Channel Upper", color=color.new(#2196F3, 0), linewidth=2)
p_mid  = plot(show_tactical ? mid_3m : na, "3M Channel Midline", color=color.new(#90CAF9, 20), linewidth=1, style=plot.style_line)
p_low  = plot(show_tactical ? low_3m : na, "3M Channel Lower", color=color.new(#2196F3, 0), linewidth=2)

// Leeway bands
p_top_lee = plot(show_tactical ? top_leeway_floor : na, "3M Top Leeway", color=color.new(#FF5252, 60), style=plot.style_stepline)
p_bot_lee = plot(show_tactical ? bottom_leeway_ceiling : na, "3M Bottom Leeway", color=color.new(#4CAF50, 60), style=plot.style_stepline)
p_stopgap = plot(show_tactical ? stopgap_floor : na, "3M Stopgap Level", color=color.new(#E91E63, 50), style=plot.style_circles)

// Fill Channel & Leeway Zones
fill(p_up, p_top_lee, color=color.new(color.red, 90), title="Top Leeway Zone")
fill(p_low, p_bot_lee, color=color.new(color.green, 90), title="Bottom Leeway Zone")
fill(p_mid, p_low, color=color.new(color.blue, 96), title="Lower Channel Fill")
fill(p_up, p_mid, color=color.new(color.blue, 96), title="Upper Channel Fill")

// Intermediate 1Y & Macro 5Y Midlines
plot(show_intermediate ? mid_1y : na, "1Y Intermediate Midline", color=color.new(#FF9800, 20), linewidth=2)
plot(show_macro ? mid_5y : na, "5Y Macro Midline", color=color.new(#9C27B0, 30), linewidth=2)

// Active Stop Loss Plot
plot(strategy.position_size > 0 ? active_stop_level : na, "Active Ratchet Stop", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Visual Entry & Exit Shapes
plotshape(long_entry_condition and not is_confluence and channel_curl_entry, title="Channel Curl Buy", style=shape.triangleup, location=location.belowbar, color=color.yellow, textcolor=color.black, size=size.small, text="CURL BUY")
plotshape(long_entry_condition and not is_confluence and mid_cross_up and not channel_curl_entry, title="Midline Cross Buy", style=shape.triangleup, location=location.belowbar, color=color.new(#0EA5E9, 0), size=size.small, text="MID CROSS")
plotshape(long_entry_condition and not is_confluence and reclaimed_channel and not channel_curl_entry and not mid_cross_up, title="Lower Reclaim Buy", style=shape.triangleup, location=location.belowbar, color=color.new(#00BCD4, 0), size=size.small, text="RECLAIM")
plotshape(long_entry_condition and not is_confluence and not reclaimed_channel and not channel_curl_entry and not mid_cross_up, title="Tactical Bounce Buy", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(long_entry_condition and is_confluence, title="Confluence Grade A Buy", style=shape.labelup, location=location.belowbar, color=color.teal, textcolor=color.white, size=size.normal, text="GRADE A")
